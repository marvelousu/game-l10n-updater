; Engine configuration file.
; The demo is intentionally isolated under godot/ and uses only the core
; Godot theme; no downloaded art or fonts are required.

config_version=5

[application]

config/name="Game L10n Text Check Demo"
config/description="Isolated demonstration of runtime display checks for localized Godot UI text."
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/show_image=false

[display]

window/size/viewport_width=1000
window/size/viewport_height=650
window/size/window_width_override=1000
window/size/window_height_override=650
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
